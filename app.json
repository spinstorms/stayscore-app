{
  "expo": {
    "name": "StayOdds",
    "slug": "stayodds",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "stayodds",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stayodds.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIRequiresFullScreen": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stayodds.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0E14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appStoreTitle": "StayOdds: Hotel Score Compare",
      "appStoreSubtitle": "Critics vs Real Guest Reviews",
      "foundingContributor": "The Uncharted Itinerary",
      "apiBaseUrl": "https://live.uncharteditinerary.com",
      "websiteUrl": "https://www.uncharteditinerary.com"
    }
  }
}
