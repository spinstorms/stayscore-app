{
  "expo": {
    "name": "StayOdds",
    "slug": "stayodds",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "stayodds",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stayodds.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIRequiresFullScreen": false,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "StayOdds can show where you are on the hotel map so you can find luxury hotels near you. Your location stays on your phone.",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "com.stayodds.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EFE9D8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAkurUSqFAiIXe8iH163a3y-YmT2iBZAVw"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EFE9D8"
        }
      ],
      "expo-sharing",
      "expo-maps"
    ],
    "experiments": {
